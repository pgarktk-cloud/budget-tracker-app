{
  // Deployment config for the Allocation Worker (sync + market-data proxy).
  //
  // WHY THIS FILE EXISTS: a Durable Object class can only be created at deploy
  // time, and the dashboard editor cannot do it. So this Worker moved from
  // dashboard-managed to `npx wrangler deploy` on 2026-08-05.
  //
  // ⚠ A deploy REPLACES the Worker's bindings with what is declared here.
  // Anything missing from this file is silently unbound. ALLOC_KV in
  // particular must stay, both as the rollback mirror and because the Durable
  // Object seeds itself from it on first use.
  //
  // Secrets (SYNC_TOKEN, FINNHUB_KEY) are NOT here and are NOT touched by a
  // deploy — they stay as set in the dashboard. Nothing secret belongs in this
  // file; the repo is public.
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "alloc-kv",
  "main": "worker.js",
  // Deliberately the SAME date the Worker is already running (verified with
  // `wrangler versions view`), so this deploy changes the sync backend and
  // nothing else. Raising it would quietly opt into unrelated runtime changes
  // in the same release. It only needs to be >= 2024-04-03 for Durable Object
  // RPC methods, which this comfortably is.
  "compatibility_date": "2026-06-27",

  // Declarative class lifecycle (replaced the imperative `migrations` array in
  // June 2026). `exports` and `migrations` are mutually exclusive — this Worker
  // has never had a migrations array, so it starts on the modern one.
  // New namespaces must be SQLite-backed, which is also what this account's
  // plan allows.
  "exports": {
    "SyncRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "durable_objects": {
    "bindings": [
      { "name": "SYNC_ROOM", "class_name": "SyncRoom" }
    ]
  },

  // Verified 2026-08-05 against the deployed Worker
  // (`wrangler versions view` showed env.ALLOC_KV → 2bd680…), NOT guessed from
  // the namespace title. The account also has a SYNC_KV namespace holding
  // `user:data:<uuid>` keys from an older version of the app — it is not bound
  // here and must not be: this Worker has never read it.
  "kv_namespaces": [
    { "binding": "ALLOC_KV", "id": "2bd680dbc44a480293246ce4c75d541e" }
  ]

  // Observability/logs deliberately NOT enabled here: the deployed Worker
  // doesn't have it, and this release should change the sync backend and
  // nothing else. Worth turning on separately if the cutover ever needs
  // diagnosing.
}
